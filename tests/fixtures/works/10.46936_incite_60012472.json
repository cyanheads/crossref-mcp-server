        "project-title": [
          {
            "title": "Toward In-Service Realism: DNS of Roughness Effects on Vital Turbine Film-Cooling"
          }
        ],
        "project-description": [
          {
            "description": "This project will improve our understanding of how in-service roughness on turbine blades affects the vital gas turbine cooling flows by leveraging recent advances in first-principle based turbulence simulation capability. The new knowledge will help improve low fidelity industrial design tools and aid global efforts to reduce fuel use and emissions."
          }
