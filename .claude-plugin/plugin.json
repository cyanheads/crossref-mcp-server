{
  "name": "@cyanheads/crossref-mcp-server",
  "version": "0.1.9",
  "description": "Resolve DOIs, search ~155M scholarly works, and fetch references via the Crossref REST API. STDIO or Streamable HTTP.",
  "author": {
    "name": "cyanheads"
  },
  "homepage": "https://github.com/cyanheads/crossref-mcp-server#readme",
  "repository": "https://github.com/cyanheads/crossref-mcp-server",
  "license": "Apache-2.0",
  "mcpServers": {
    "@cyanheads/crossref-mcp-server": {
      "command": "npx",
      "args": ["-y", "@cyanheads/crossref-mcp-server", "run", "start:stdio"],
      "env": {
        "MCP_TRANSPORT_TYPE": "stdio",
        "CROSSREF_MAILTO": ""
      }
    }
  }
}
