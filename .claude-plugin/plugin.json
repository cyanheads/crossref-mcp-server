{
  "name": "crossref-mcp-server",
  "version": "0.3.6",
  "description": "Resolve DOIs, search ~155M scholarly works, fetch references, and look up publishers via the Crossref REST API. STDIO or Streamable HTTP.",
  "author": {
    "name": "cyanheads"
  },
  "homepage": "https://github.com/cyanheads/crossref-mcp-server#readme",
  "repository": "https://github.com/cyanheads/crossref-mcp-server",
  "license": "Apache-2.0",
  "mcpServers": {
    "crossref-mcp-server": {
      "command": "npx",
      "args": ["-y", "@cyanheads/crossref-mcp-server"],
      "env": {
        "MCP_TRANSPORT_TYPE": "stdio",
        "CROSSREF_MAILTO": ""
      }
    }
  }
}
