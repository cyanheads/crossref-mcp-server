{
  "manifest_version": "0.3",
  "name": "crossref-mcp-server",
  "version": "0.3.10",
  "description": "Resolve DOIs, search ~155M scholarly works, fetch references, and look up publishers via the Crossref REST API. STDIO or Streamable HTTP.",
  "author": {
    "name": "cyanheads"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cyanheads/crossref-mcp-server"
  },
  "homepage": "https://github.com/cyanheads/crossref-mcp-server#readme",
  "license": "Apache-2.0",
  "server": {
    "type": "node",
    "entry_point": "dist/index.js",
    "mcp_config": {
      "command": "node",
      "args": ["${__dirname}/dist/index.js"],
      "env": {
        "MCP_TRANSPORT_TYPE": "stdio",
        "MCP_AUTH_MODE": "none",
        "NODE_ENV": "production",
        "CROSSREF_MAILTO": "${CROSSREF_MAILTO}"
      }
    }
  },
  "compatibility": {
    "runtimes": {
      "node": ">=24.0.0"
    }
  },
  "tools_generated": true,
  "prompts_generated": true,
  "user_config": {
    "CROSSREF_MAILTO": {
      "type": "string",
      "title": "Crossref Polite Pool Email",
      "description": "Email for polite-pool User-Agent header — optional. Without: anonymous pool with stricter rate limits.",
      "required": false,
      "default": ""
    }
  }
}
